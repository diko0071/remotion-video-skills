# Copy to .env.local and fill in. Keys are read env -> .env.local
# (see src/services/env.ts). NEVER commit real keys.

# ElevenLabs — background music generation (bun run video)
ELEVENLABS_API_KEY=

# Anthropic — AI validation of the contact sheet (bun run validate)
ANTHROPIC_API_KEY=

# OpenAI — optional, gpt-image-2 asset generation (src/services/openai)
OPENAI_API_KEY=

